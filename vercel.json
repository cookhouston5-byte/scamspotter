{ "version": 2, "builds": [ { "src": "server.js", "use": "@vercel/node" }, { "src": "public/**", "use": "@vercel/static" } ],
  "routes": [ { "src": "/api/(.*)", "dest": "/server.js" }, { "src": "/check", "dest": "/public/check.html" }, { "src": "/(privacy|terms|about|welcome)", "dest": "/public/$1.html" }, { "src": "/(.*)", "dest": "/public/$1" } ] }
